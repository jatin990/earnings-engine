# =============================================================================
# Earnings Engine - Environment Variables Template (.env.example)
# =============================================================================

# --- Storage & Data Directories ---
# Directory where price histories, SQLite DB, and caches are stored.
# Default: ./data (Local) or /tmp/data (Vercel / Serverless)
EARNINGS_ENGINE_DATA_DIR=./data

# --- Concurrency & Workers ---
EARNINGS_ENGINE_PRICE_FETCH_WORKERS=10
EARNINGS_ENGINE_GBM_FEATURE_WORKERS=8
EARNINGS_ENGINE_KRONOS_FETCH_WORKERS=8
EARNINGS_ENGINE_KRONOS_EXPLAIN_WORKERS=4

# --- AI & Forecasting Model Inference (Kronos) ---
# Device: "cuda", "cuda:0", "cpu", or leave blank for auto-detect (default on Vercel is "cpu")
EARNINGS_ENGINE_KRONOS_DEVICE=
EARNINGS_ENGINE_KRONOS_GPU_BATCH_SIZE=2

# --- Email & SMTP Notifications ---
EARNINGS_ENGINE_EMAIL_ENABLED=false
EARNINGS_ENGINE_SMTP_HOST=smtp.gmail.com
EARNINGS_ENGINE_SMTP_PORT=587
EARNINGS_ENGINE_SMTP_USERNAME=your.email@gmail.com
EARNINGS_ENGINE_SMTP_PASSWORD=your_16_char_app_password
EARNINGS_ENGINE_EMAIL_FROM=your.email@gmail.com
EARNINGS_ENGINE_EMAIL_TO=recipient.email@gmail.com
