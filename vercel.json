{
  "version": 2,
  "git": {
    "deploymentEnabled": true
  },
  "github": {
    "autoJobCancellation": true
  },
  "ignoreCommand": "bash scripts/vercel_ignore_step.sh",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py?__vercel_path__=/$1"
    }
  ]
}
